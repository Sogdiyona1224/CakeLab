# Copy this file to ".env" and fill in your own key.
# Get one at https://console.anthropic.com/settings/keys
#
# WARNING: This key gets bundled into the browser JS and is visible to
# anyone who opens dev tools. That's fine for local testing on your own
# machine, but do NOT deploy this publicly as-is — move the API call to
# a backend/serverless function first (see README.md).
VITE_ANTHROPIC_API_KEY=
